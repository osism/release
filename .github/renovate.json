{
  "extends": [
    "github>osism/renovate-config",
    "github>osism/renovate-config:python"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^latest\\/base.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>github-releases) depName=(?<depName>.*?)\n.*?docker: '5:(?<currentValue>.*?)'"
      ],
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^latest\\/base.yml$/",
        "/^latest\\/ceph-quincy.yml$/",
        "/^latest\\/ceph-reef.yml$/",
        "/^latest\\/ceph-squid.yml$/",
        "/^latest\\/ceph-tentacle.yml$/",
        "/^latest\\/openstack-2024.1.yml$/",
        "/^latest\\/openstack-2024.2.yml$/",
        "/^latest\\/openstack-2025.1.yml$/",
        "/^latest\\/openstack-2025.2.yml$/",
        "/^latest\\/openstack-2026.1.yml$/",
        "/^latest\\/openstack-2026.2.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>docker) depName=(?<depName>.*?)\n.*?: '(?<currentValue>.*?)'",
        "# renovate: datasource=(?<datasource>pypi) depName=(?<depName>.*?)\n.*?: '(?<currentValue>.*?)'",
        "# renovate: datasource=(?<datasource>github-tags) depName=(?<depName>.*?)\n.*?: '(?<currentValue>.*?)'",
        "# renovate: datasource=(?<datasource>github-releases) depName=(?<depName>.*?)\n.*?: '(?<currentValue>.*?)'",
        "# renovate: datasource=(?<datasource>galaxy-collection) depName=(?<depName>.*?)\n.*?: '(?<currentValue>.*?)'"
      ]
    }
  ],
  "packageRules": [
    {
      "matchDepNames": [
        "ansible",
        "ansible-core"
      ],
      "matchFileNames": [
        "latest/ceph-quincy.yml",
        "latest/ceph-reef.yml",
        "latest/ceph-squid.yml",
        "latest/openstack-2024.1.yml",
        "latest/openstack-2024.2.yml",
        "latest/openstack-2025.1.yml",
        "latest/openstack-2025.2.yml",
        "latest/openstack-2026.1.yml",
        "latest/openstack-2026.2.yml"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "enabled": true,
      "groupName": "ansible"
    },
    {
      "matchDepNames": [
        "ansible",
        "ansible-core"
      ],
      "matchFileNames": [
        "latest/ceph-quincy.yml",
        "latest/ceph-reef.yml",
        "latest/ceph-squid.yml",
        "latest/openstack-2024.1.yml",
        "latest/openstack-2024.2.yml",
        "latest/openstack-2025.1.yml",
        "latest/openstack-2025.2.yml",
        "latest/openstack-2026.1.yml",
        "latest/openstack-2026.2.yml"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    },
    {
      "matchDepNames": [
        "registry.osism.tech/osism/ceph-daemon",
        "registry.osism.tech/osism/cephclient"
      ],
      "matchFileNames": [
        "latest/ceph-quincy.yml",
        "latest/ceph-reef.yml",
        "latest/ceph-squid.yml",
        "latest/ceph-tentacle.yml"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "matchDepNames": [
        "ansible",
        "ansible-core"
      ],
      "matchFileNames": [
        "latest/base.yml"
      ],
      "groupName": "ansible"
    },
    {
      "matchDepNames": [
        "registry.osism.tech/osism/ceph-daemon",
        "registry.osism.tech/osism/cephclient"
      ],
      "matchFileNames": [
        "latest/ceph-quincy.yml",
        "latest/ceph-reef.yml",
        "latest/ceph-squid.yml",
        "latest/ceph-tentacle.yml"
      ],
      "groupName": "ceph"
    },
    {
      "description": [
        "The OpenStack series from 2025.1 on pin the same openstackclient",
        "version, so their files move together."
      ],
      "matchDepNames": [
        "registry.osism.tech/osism/openstackclient"
      ],
      "matchFileNames": [
        "latest/openstack-2025.1.yml",
        "latest/openstack-2025.2.yml",
        "latest/openstack-2026.1.yml",
        "latest/openstack-2026.2.yml"
      ],
      "groupName": "openstackclient"
    },
    {
      "matchDepNames": [
        "postgres",
        "pgautoupgrade/pgautoupgrade"
      ],
      "matchFileNames": [
        "latest/base.yml"
      ],
      "groupName": "postgres"
    },
    {
      "matchDepNames": [
        "registry.osism.tech/osism/osism",
        "osism"
      ],
      "matchFileNames": [
        "latest/base.yml"
      ],
      "groupName": "osism"
    },
    {
      "description": [
        "The ansible containers share one Redis fact cache, and its key schema",
        "depends on the ansible-core version: from 2.19 on, entries carry an s1_",
        "prefix and a __payload__ wrapper. osism-ansible and kolla-ansible write",
        "the s1_ schema, ceph-ansible (capped <2.17) the old one, and",
        "python-osism reads both. A new ansible-core minor can change the schema",
        "again, so minor and major bumps stay manual; check the cache key format",
        "and python-osism's osism/utils/fact_cache.py before taking one.",
        "tests/test_ansible_core_fact_cache.py guards the osism pins."
      ],
      "matchDepNames": [
        "ansible",
        "ansible-core"
      ],
      "matchFileNames": [
        "latest/base.yml"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    }
  ]
}
