{
  "extends": [
    "github>osism/renovate-config",
    "github>osism/renovate-config:python"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^latest\\/base.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>github-releases) depName=(?<depName>.*?)\n.*?docker: '5:(?<currentValue>.*?)'"
      ],
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^latest\\/base.yml$/",
        "/^latest\\/ceph-quincy.yml$/",
        "/^latest\\/ceph-reef.yml$/",
        "/^latest\\/ceph-squid.yml$/",
        "/^latest\\/openstack-2024.1.yml$/",
        "/^latest\\/openstack-2024.2.yml$/",
        "/^latest\\/openstack-2025.1.yml$/",
        "/^latest\\/openstack-2025.2.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>docker) depName=(?<depName>.*?)\n.*?: '(?<currentValue>.*?)'",
        "# renovate: datasource=(?<datasource>pypi) depName=(?<depName>.*?)\n.*?: '(?<currentValue>.*?)'",
        "# renovate: datasource=(?<datasource>github-tags) depName=(?<depName>.*?)\n.*?: '(?<currentValue>.*?)'",
        "# renovate: datasource=(?<datasource>github-releases) depName=(?<depName>.*?)\n.*?: '(?<currentValue>.*?)'",
        "# renovate: datasource=(?<datasource>galaxy-collection) depName=(?<depName>.*?)\n.*?: '(?<currentValue>.*?)'"
      ]
    }
  ],
  "packageRules": [
    {
      "matchDepNames": [
        "ansible",
        "ansible-core"
      ],
      "matchFileNames": [
        "latest/ceph-quincy.yml",
        "latest/ceph-reef.yml",
        "latest/ceph-squid.yml",
        "latest/openstack-2024.1.yml",
        "latest/openstack-2024.2.yml",
        "latest/openstack-2025.1.yml",
        "latest/openstack-2025.2.yml"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "enabled": true,
      "groupName": "ansible"
    },
    {
      "matchDepNames": [
        "ansible",
        "ansible-core"
      ],
      "matchFileNames": [
        "latest/ceph-quincy.yml",
        "latest/ceph-reef.yml",
        "latest/ceph-squid.yml",
        "latest/openstack-2024.1.yml",
        "latest/openstack-2024.2.yml",
        "latest/openstack-2025.1.yml",
        "latest/openstack-2025.2.yml"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    },
    {
      "matchDepNames": [
        "registry.osism.tech/osism/ceph-daemon",
        "registry.osism.tech/osism/cephclient"
      ],
      "matchFileNames": [
        "latest/ceph-quincy.yml",
        "latest/ceph-reef.yml",
        "latest/ceph-squid.yml"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "matchDepNames": [
        "ansible",
        "ansible-core"
      ],
      "matchFileNames": [
        "latest/base.yml"
      ],
      "groupName": "ansible"
    },
    {
      "matchDepNames": [
        "registry.osism.tech/osism/ceph-daemon",
        "registry.osism.tech/osism/cephclient"
      ],
      "matchFileNames": [
        "latest/ceph-quincy.yml",
        "latest/ceph-reef.yml",
        "latest/ceph-squid.yml"
      ],
      "groupName": "ceph"
    },
    {
      "matchDepNames": [
        "postgres",
        "pgautoupgrade/pgautoupgrade"
      ],
      "matchFileNames": [
        "latest/base.yml"
      ],
      "groupName": "postgres"
    },
    {
      "matchDepNames": [
        "registry.osism.tech/osism/osism",
        "osism"
      ],
      "matchFileNames": [
        "latest/base.yml"
      ],
      "groupName": "osism"
    },
    {
      "description": [
        "The ansible containers share one Redis fact cache, and ansible-core 2.19",
        "namespaces cache entries with an s1_ key prefix, so a core that crosses",
        "2.19 writes where kolla-ansible and ceph-ansible cannot read. Those two",
        "cap ansible-core at <2.19 and <2.17 respectively, and cloud.common 5.0.0",
        "declares requires_ansible >=2.15.0,<2.19. Blocking minor is deliberate:",
        "for ansible-core, 2.18 -> 2.19 is a minor bump. The per-release files",
        "already have this policy; base.yml was the only ansible pin left",
        "floating. Lift once kolla-ansible gathers its own facts or the cache is",
        "split per container. See osism/issues#1420."
      ],
      "matchDepNames": [
        "ansible",
        "ansible-core"
      ],
      "matchFileNames": [
        "latest/base.yml"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    }
  ]
}
